BEGIN # operator symbols and declarers accepted by a68g beyond the basics #
   OP!=(INT c)CHAR: REPR (c + 32);
   print ((!33, !34, newline));
   OP +> = (INT a)INT: a + 1;
   print ((+> 4, +> +> 4, newline));
   OP -=: = (REF INT a)INT: (a := -a; a);
   INT q := 3;
   print ((2 * -=: q, q, newline));

   # one bold word as a dyadic operator with a priority and as a monadic one #
   PRIO X = 7;
   OP X = (INT a, b)INT: a * b;
   OP X = (INT a)INT: -a;
   print ((3 X 4, X 5, 2 X X 3, newline));

   # NEW is HEAP; ZAHL and DOUBLE come from the standard environ #
   REF INT n = NEW INT := 3;
   print ((n, newline));
   ZAHL z = 12;
   DOUBLE d = 1.5;
   print ((z, SHORTEN d > 1.4, newline));

   # parentheses as the brackets of a row declarer #
   (1:3)INT arr;
   arr[2] := 5;
   print ((arr[2], UPB arr, newline));
   REF () INT r = LOC [1:2] INT := (7, 8);
   print ((r[2], newline));

   # SEMA values outside a parallel clause #
   SEMA s = LEVEL 3;
   print ((LEVEL s, newline));
   MODE U = UNION (INT, SEMA);
   U u = LEVEL 1;
   CASE u IN (SEMA): print (("sema", newline)), (INT): print (("int", newline)) ESAC
END
