# a68g format items: bits patterns (r), h patterns, C-style patterns (%), n replicators #
printf(($2r8d l$, BIN 5));
printf(($16r8d l$, BIN 255));
printf(($16r8z l$, BIN 255));
printf(($8r6zd"|" l$, BIN 8));
printf(($"x"2r3d"y" l$, BIN 5));
INT base = 16;
printf(($n(base)r4d l$, BIN 300));
printf(($16r2d","2d l$, BIN 4095));
printf(($g l$, BIN 5));
printf(($%d l$, 42));
printf(($%5d"|" l$, 42));
printf(($%-5d"|" l$, 42));
printf(($%+5d"|" l$, 42));
printf(($%x l$, BIN 255));
printf(($%8x"|" l$, BIN 255));
printf(($%b l$, BIN 5));
printf(($%o l$, BIN 8));
printf(($%s"|" l$, "hello"));
printf(($%10s"|" l$, "hello"));
printf(($%-10s"|" l$, "hello"));
printf(($%f"|" l$, 3.14159));
printf(($%e"|" l$, 3.14159));
printf(($%g"|" l$, 3.14159));
printf(($%10.3f"|" l$, 3.14159));
printf(($%.3e"|" l$, 3.14159));
printf(($%g"|" l$, 31415926.0));
printf(($%12.2g"|" l$, 0.000031));
printf(($%i"|" l$, -42));
printf(($%g"|" l$, 42));
printf(($%f"|" l$, 42));
printf(($%-12f"|" l$, -3.5));
printf(($%+8.2f"|" l$, 3.5));
printf(($%2x"|" l$, BIN 255));
printf(($%-12x"|" l$, BIN 255));
printf(($%5.2s"|" l$, "ab"));
printf(($h(1)"|"l$, 3.14159));
printf(($h(3)"|"l$, 31415.9));
printf(($h(2,3)"|"l$, 31415.9));
printf(($h(12,2,3)"|"l$, 31415.9));
printf(($h(12,2,3,3)"|"l$, 31415.9));
printf(($h(1)"|"l$, 42));
printf(($h"|"l$, 3.5));
printf(($h"|"l$, 42));
printf(($h(2)"|"l$, 0.00123));
printf(($3(h(1))"|"l$, 1.5, 2.5, 3.5));
printf(($h(0)"|"l$, 3.5));
printf(($h(1)"|"l$, -1234567.0));
printf(($h(2,6)"|"l$, 1234567.0));
INT k = 3;
printf(($g, n (k) x, "|"l$, "ab"));
printf(($n (2)d, n(3) d"|"l$, 12, 345));
FILE f; STRING s := "  42 3.5 abcdef 0000ff 12";
associate(f, s);
INT i; REAL r; STRING t; BITS b; INT j;
getf(f, ($%4d%4f%7s%7x x%d$, i, r, t, b, j));
print((i, r, t, "|", ABS b, j, newline));
STRING s2 := "hello world";
FILE g; associate(g, s2); STRING t2; CHAR c;
getf(g, ($%c%s$, c, t2)); print((c, "|", t2, "|", newline));
STRING s3 := "abcdef";
FILE h; associate(h, s3); CHAR c3;
getf(h, ($%3c$, c3)); print((c3, newline));
STRING s4 := "1010 ffff";
FILE h4; associate(h4, s4); BITS b1, b2;
getf(h4, ($%b x%x$, b1, b2)); print((ABS b1, ABS b2, newline));
BITS bb;
FILE f5; STRING s5 := "ff 0101 12";
associate(f5, s5);
getf(f5, ($16r2d$, bb)); print((ABS bb, newline));
getf(f5, ($x2r4d$, bb)); print((ABS bb, newline));
getf(f5, ($x8r2d$, bb)); print((ABS bb, newline));
# a COMPL takes two patterns; a UNION is read with the mode of its current value #
COMPL z := 1.5 I 2.5;
printf(($gl$, z));
printf(($g(-6,2)"|"g(-6,2)l$, z));
UNION (INT, REAL) u := 5;
FILE f6; STRING s6 := "42 3.5 7";
associate(f6, s6);
get(f6, u);
CASE u IN (INT n): print(("int ", n, newline)), (REAL x): print(("real ", x, newline)) ESAC;
u := 1.0;
get(f6, u);
CASE u IN (INT n): print(("int ", n, newline)), (REAL x): print(("real ", x, newline)) ESAC;
COMPL w;
FILE f7; STRING s7 := "1.5 2.5 3.5 4.5";
associate(f7, s7);
get(f7, w);
print((w, newline));
getf(f7, ($g$, w));
print((w, newline))
