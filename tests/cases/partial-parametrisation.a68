# partial parametrisation (a68g implements Lindsey's proposal) #
PROC f = (INT a, b, c)INT: a * 100 + b * 10 + c;
PROC (INT)INT g = f (1, , 3);
print ((g (2), newline));
PROC (INT, INT)INT h = f (, 5, );
PROC (INT)INT k = h (4, );
print ((k (6), h (1, 2), f (7, , ) (8, ) (9), newline));

# the arguments given are evaluated at the partial call #
INT v := 1;
PROC (INT)INT m = f (v, , v);
v := 9;
print ((m (0), newline));
PROC side = (INT a, b)INT: a + b;
PROC (INT)INT s = side ((print ("E"); 1), );
print (("X", s (2), newline));

# so is the procedure: a later assignment to a PROC variable does not change it #
PROC (INT, INT)INT p := (INT a, b)INT: a - b;
PROC (INT)INT q = p (10, );
p := (INT a, b)INT: a * b;
print ((q (3), p (10, 3), newline));

# currying in a routine, and rows of partial procedures #
MODE F = PROC (REAL)REAL;
PROC compose = (F f, g)F: ((F f2, g2, REAL x)REAL: f2 (g2 (x))) (f, g, );
F plus one = (REAL x)REAL: x + 1, twice = (REAL x)REAL: 2 * x;
print ((fixed (compose (plus one, twice) (3.5), 0, 2), newline));
[]PROC (INT)INT ps = (f (1, 2, ), f (, 1, 2));
print ((ps[1] (5), ps[2] (5), newline));

# a partial call in a void context is just voided #
PROC shout = (INT a, STRING t)VOID: print ((t, whole (a, 0), newline));
shout (1, );
shout (2, "two ")
