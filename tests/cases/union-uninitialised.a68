# A union never given a value is not an error to copy, pass or inspect: no alternative of #
# a conformity clause takes it.                                                            #
BEGIN
  MODE V = UNION (INT, REAL);
  PROC f = (V x) STRING: CASE x IN (INT): "int", (REAL): "real" OUT "none" ESAC;
  V a;
  [1:3] V r;
  STRUCT (INT i, V v) s;
  print((f(a), " ", f(r[2]), " ", f(v OF s), newline));
  V b := a;
  print((f(b), newline));
  [1:3] V q := r;
  q[2] := 2.5;
  FOR i TO 3 DO print((f(q[i]), " ")) OD;
  print(newline);
  V c := SKIP;
  CASE c IN (INT k): print((k, newline)) OUT print(("out", newline)) ESAC;
  c := 7;
  CASE c IN (INT k): print((k, newline)) OUT print(("out", newline)) ESAC;
  MODE W = UNION (INT, STRING);
  W w;
  CASE w IN (INT k): print(k), (STRING t): print(t) OUT print("empty") ESAC;
  w := "abc";
  CASE w IN (INT k): print(k), (STRING t): print(t) OUT print("empty") ESAC;
  print(newline)
END
