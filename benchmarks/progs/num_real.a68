# REAL scalar arithmetic: a 2-D rotation recurrence plus an accumulator, 5 million times. #
# ops: 4e7  (one REAL multiply or add/subtract per op)                                    #
BEGIN
  REAL x := 0.0, y := 1.0, s := 0.0;
  FOR i TO 5000000 DO
    REAL t = x * 0.6 + y * 0.8;
    y := y * 0.6 - x * 0.8;
    x := t;
    s := s + x * x
  OD;
  print((ROUND (s * 1000000.0 / 5000000.0), newline))
END
